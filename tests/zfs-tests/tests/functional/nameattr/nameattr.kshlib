. $STF_SUITE/include/libtest.shlib

#
# Dump object $obj in $dataset with zdb and print the value of the given
# per-object field (e.g. "name" or "path").  Prints an empty string if
# the field is absent.  Five -d are needed for zdb to print the path.
#
# zdb reads the on-disk state, so the pool is synced first.
#
function zdb_obj_field # dataset obj field
{
	typeset ds=$1 obj=$2 field=$3

	sync_pool "${ds%%/*}" >/dev/null
	zdb -ddddd "$ds" "$obj" | awk -F'\t' -v f="$field" \
	    '$2 == f { print $3; exit }'
}

#
# Same as zdb_obj_field for the object behind $path.
#
function zdb_znode_field # dataset path field
{
	typeset ds=$1 path=$2 field=$3

	zdb_obj_field "$ds" "$(get_objnum "$path")" "$field"
}

#
# Assert the object at $path carries ZPL_NAME equal to $expected.
#
function verify_name # dataset path expected
{
	typeset ds=$1 path=$2 expected=$3
	typeset actual

	actual=$(zdb_znode_field "$ds" "$path" name)
	[[ "$actual" == "$expected" ]] ||
	    log_fail "$path: name is '$actual', expected '$expected'"
	log_note "$path: name='$actual'"
}

#
# Assert the object at $path carries no ZPL_NAME at all.
#
function verify_no_name # dataset path
{
	typeset ds=$1 path=$2
	typeset actual

	actual=$(zdb_znode_field "$ds" "$path" name)
	[[ -z "$actual" ]] ||
	    log_fail "$path: unexpected name '$actual'"
	log_note "$path: no name (expected)"
}

#
# Assert that zdb's own ZAP-derived path for the object matches the
# path we know it by.  zdb prints the path relative to the dataset root.
#
function verify_zdb_path # dataset path
{
	typeset ds=$1 path=$2
	typeset mntpnt rel actual

	mntpnt=$(get_prop mountpoint "$ds")
	rel=${path#$mntpnt}
	actual=$(zdb_znode_field "$ds" "$path" path)
	[[ "$actual" == "$rel" ]] ||
	    log_fail "$path: zdb path is '$actual', expected '$rel'"
}
